{
  "expo": {
    "name": "plattayam-mobile",
    "slug": "plattayam-mobile",
    "scheme": "plattayam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plattayam.blakc-coffee",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.blakccoffee.plattayammobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Plattayam | IIIT Kottayam Student Utility Platform",
      "shortName": "Plattayam",
      "description": "All-in-one campus utility for IIIT Kottayam: cab sharing, hackathon team finder (HackMate), and lost & found management.",
      "themeColor": "#0284c7",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "eas": {
        "projectId": "b6028a8c-916e-4cb7-a75a-4f2309fcc8d8"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}

