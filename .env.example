# Database Connection URL (MySQL / PostgreSQL / SQLite)
# Production MySQL example: mysql://user:password@hostname:3306/dbname
# Local fallback default is sqlite:///./test.db
DATABASE_URL=sqlite:///./test.db

# JWT Security
# Generate a strong 256-bit random hex secret: openssl rand -hex 32
JWT_SECRET=supersecretkey_change_me_in_production_12345
ACCESS_TOKEN_EXPIRE_MINUTES=129600 # 90 days for mobile session persistence

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Domain Restriction (Set RESTRICT_DOMAIN=true to enforce campus email only)
RESTRICT_DOMAIN=false
ALLOWED_EMAIL_DOMAIN=iiitkottayam.ac.in

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:19006,exp://localhost:8081

# Server Port
PORT=8000
